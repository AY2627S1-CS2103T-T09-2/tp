<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root resizable="true" title="Help" type="javafx.stage.Stage"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">

  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>

  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <StackPane fx:id="helpWindowRoot" alignment="TOP_CENTER">
        <children>
          <VBox minHeight="0.0" minWidth="0.0" maxWidth="1120.0" maxHeight="800.0" spacing="16.0">
            <children>
              <VBox spacing="6.0">
                <children>
                  <Label fx:id="commandGuideTitle"
                         text="Easy-Insurance Command Guide"
                         minWidth="0.0" maxWidth="Infinity" wrapText="true"
                         styleClass="command-guide-title" />
                  <FlowPane fx:id="commandGuideLegend" hgap="24.0" vgap="6.0" minWidth="0.0">
                    <children>
                      <Label text="Fields in [brackets] are optional."
                             wrapText="true" styleClass="command-guide-hint" />
                      <Label text="... means repeatable."
                             wrapText="true" styleClass="command-guide-hint" />
                    </children>
                  </FlowPane>
                </children>
              </VBox>

              <ScrollPane fx:id="commandGuideScrollPane"
                          fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                          minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                <content>
                  <VBox fx:id="commandGuideRows" minWidth="0.0">
                    <children>
                      <GridPane fx:id="commandGuideTable" hgap="20.0"
                                styleClass="command-guide-table-heading">
                        <children>
                          <Label text="Command"
                                 styleClass="command-guide-cell, command-guide-column-heading"
                                 GridPane.columnIndex="0" maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-column-heading"
                                 GridPane.columnIndex="1" maxWidth="Infinity" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-column-heading"
                                 GridPane.columnIndex="2" maxWidth="Infinity" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="add"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="add n/NAME p/PHONE_NUMBER e/EMAIL a/ADDRESS [st/STATUS] [f/FOLLOW_UP_DATE] [t/TAG]..."
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="add n/Sarah Lim p/98765432 e/sarahlim@example.com a/Tampines st/PROSPECT f/25-12-2026 t/referral"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="clear"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="clear [confirm]"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="clear&#10;clear confirm"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="contacted"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="contacted INDEX d/DD-MM-YYYY"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="contacted 2 d/27-10-2026"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="delete"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="delete INDEX"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="delete 2"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="done"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="done INDEX"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="done 1"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="due"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="due [DAYS]"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="due 7"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="edit"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="edit INDEX [n/NAME] [p/PHONE_NUMBER] [e/EMAIL] [a/ADDRESS] [st/STATUS] [f/FOLLOW_UP_DATE] [t/TAG]..."
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="edit 1 p/91234567 st/CLIENT"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="find"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="find KEYWORD [MORE_KEYWORDS]&#10;or find p/PHONE_DIGITS"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="find ta&#10;find p/9123"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="history"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="history INDEX"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="history 2"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="deletenote"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="deletenote CONTACT_INDEX NOTE_INDEX"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="deletenote 1 2"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <!-- @@author kaseyho -->
                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="list"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="list [st/STATUS] [t/TAG]"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="list st/CLIENT t/referral"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>
                      <!-- @@author -->

                      <!-- @@author PBez02 -->
                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="note"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="note INDEX nt/NOTE"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="note 2 nt/Discussed hospital coverage"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>
                      <!-- @@author -->

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="help"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="help"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="help"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>

                      <GridPane hgap="20.0" vgap="6.0" styleClass="command-guide-row">
                        <children>
                          <Label text="exit"
                                 styleClass="command-guide-cell, command-guide-name"
                                 maxWidth="Infinity" />
                          <Label text="exit"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-format"
                                 maxWidth="Infinity" />
                          <Label text="exit"
                                 styleClass="command-guide-cell, command-guide-code, command-guide-example"
                                 maxWidth="Infinity" />
                          <Label text="Format"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-format"
                                 visible="false" managed="false" />
                          <Label text="Example"
                                 styleClass="command-guide-cell, command-guide-caption, command-guide-example"
                                 visible="false" managed="false" />
                        </children>
                      </GridPane>
                    </children>
                  </VBox>
                </content>
              </ScrollPane>

              <VBox spacing="6.0" minHeight="-Infinity" styleClass="command-guide-footer">
                <children>
                  <Label text="Full instructions are in the User Guide."
                         minWidth="0.0" maxWidth="Infinity" wrapText="true"
                         styleClass="command-guide-hint" />
                  <Label fx:id="userGuideUrl" minWidth="0.0" maxWidth="Infinity"
                         wrapText="true" styleClass="command-guide-hint" />
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                      <Button fx:id="copyButton"
                              minWidth="170.0"
                              mnemonicParsing="false"
                              onAction="#copyUrl"
                              text="Copy User Guide URL"
                              accessibleText="Copy User Guide URL" />
                      <Label fx:id="copyStatus" minWidth="0.0" minHeight="36.0" maxWidth="Infinity"
                             wrapText="true" HBox.hgrow="ALWAYS" styleClass="command-guide-hint" />
                    </children>
                  </HBox>
                </children>
              </VBox>
            </children>
          </VBox>
        </children>
      </StackPane>
    </Scene>
  </scene>
</fx:root>

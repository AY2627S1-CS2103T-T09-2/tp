<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root resizable="false" title="Help" type="javafx.stage.Stage"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">

  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>

  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <VBox spacing="10.0">
        <padding>
          <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>

        <children>
          <Label text="Easy-Insurance Command Guide"
                 style="-fx-font-size: 18px; -fx-font-weight: bold;" />

          <GridPane hgap="15.0" vgap="8.0">
            <columnConstraints>
              <ColumnConstraints minWidth="70.0" />
              <ColumnConstraints minWidth="440.0" />
              <ColumnConstraints minWidth="300.0" />
            </columnConstraints>

            <children>
              <Label text="Command"
                     style="-fx-font-weight: bold;"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="0" />
              <Label text="Format"
                     style="-fx-font-weight: bold;"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="0" />
              <Label text="Example"
                     style="-fx-font-weight: bold;"
                     GridPane.columnIndex="2"
                     GridPane.rowIndex="0" />

              <Label text="add"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="1" />
              <Label text="add n/NAME p/PHONE_NUMBER e/EMAIL a/ADDRESS [st/STATUS] [f/DD-MM-YYYY] [t/TAG]..."
                     wrapText="true"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="1" />
              <Label text="add n/John Tan p/91234567 e/john@example.com a/Clementi st/PROSPECT t/referral"
                     wrapText="true"
                     GridPane.columnIndex="2"
                     GridPane.rowIndex="1" />

              <Label text="list"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="2" />
              <Label text="list"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="2" />
              <Label text="list"
                     GridPane.columnIndex="2"
                     GridPane.rowIndex="2" />

              <Label text="find"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="3" />
              <Label text="find KEYWORD [MORE_KEYWORDS]"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="3" />
              <Label text="find John Tan"
                     GridPane.columnIndex="2"
                     GridPane.rowIndex="3" />

              <Label text="delete"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="4" />
              <Label text="delete INDEX"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="4" />
              <Label text="delete 2"
                     GridPane.columnIndex="2"
                     GridPane.rowIndex="4" />

              <Label text="done"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="5" />
              <Label text="done INDEX"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="5" />
              <Label text="done 1"
                     GridPane.columnIndex="2"
                     GridPane.rowIndex="5" />

              <Label text="clear"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="6" />
              <Label text="clear"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="6" />
              <Label text="clear"
                     GridPane.columnIndex="2"
                     GridPane.rowIndex="6" />

              <Label text="help"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="7" />
              <Label text="help"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="7" />
              <Label text="help"
                     GridPane.columnIndex="2"
                     GridPane.rowIndex="7" />

              <Label text="exit"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="8" />
              <Label text="exit"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="8" />
              <Label text="exit"
                     GridPane.columnIndex="2"
                     GridPane.rowIndex="8" />

              <Label text="edit"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="9" />
              <Label text="edit INDEX [n/NAME] [p/PHONE_NUMBER] [e/EMAIL] [a/ADDRESS] [st/STATUS] [f/DD-MM-YYYY] [t/TAG]..."
                     wrapText="true"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="9" />
              <Label text="edit 1 p/91234567 st/CLIENT"
                     GridPane.columnIndex="2"
                     GridPane.rowIndex="9" />
            </children>
          </GridPane>

          <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
              <Label text="Full documentation is available in the User Guide." />
              <Button fx:id="copyButton"
                      mnemonicParsing="false"
                      onAction="#copyUrl"
                      text="Copy URL" />
            </children>
          </HBox>
        </children>
      </VBox>
    </Scene>
  </scene>
</fx:root>

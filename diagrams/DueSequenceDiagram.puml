@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":CommandInputParser" as CommandInputParser LOGIC_COLOR
participant ":DueCommandParser" as DueCommandParser LOGIC_COLOR
participant "d:DueCommand" as DueCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "p:FollowUpDueByPredicate" as Predicate MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("due 7")
activate LogicManager

LogicManager -> CommandInputParser : parseCommand("due 7")
activate CommandInputParser

create DueCommandParser
CommandInputParser -> DueCommandParser
activate DueCommandParser

DueCommandParser --> CommandInputParser
deactivate DueCommandParser

CommandInputParser -> DueCommandParser : parse("7")
activate DueCommandParser

create DueCommand
DueCommandParser -> DueCommand : DueCommand(7)
activate DueCommand

DueCommand --> DueCommandParser
deactivate DueCommand

DueCommandParser --> CommandInputParser : d
deactivate DueCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DueCommandParser -[hidden]-> CommandInputParser
destroy DueCommandParser

CommandInputParser --> LogicManager : d
deactivate CommandInputParser

LogicManager -> DueCommand : execute(m)
activate DueCommand

create Predicate
DueCommand -> Predicate : FollowUpDueByPredicate(cutoff)
activate Predicate

Predicate --> DueCommand
deactivate Predicate

DueCommand -> Model : updateFilteredPersonList(p, BY_FOLLOW_UP_DATE)
activate Model

Model --> DueCommand
deactivate Model

DueCommand -> Model : getFilteredPersonList()
activate Model

Model --> DueCommand : due contacts
deactivate Model

create CommandResult
DueCommand -> CommandResult
activate CommandResult

CommandResult --> DueCommand
deactivate CommandResult

DueCommand --> LogicManager : r
deactivate DueCommand

[<--LogicManager
deactivate LogicManager
@enduml
